<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <mago_ai_image>
            <general>
                <enabled>0</enabled>
                <ai_service/>
                <max_images>4</max_images>
                <timeout>90</timeout>
                <max_reference_mb>10</max_reference_mb>
                <preview_retention_days>7</preview_retention_days>
            </general>
            <gemini>
                <model>gemini-nano-banana-2.1</model>
                <image_size/>
                <base_url>https://generativelanguage.googleapis.com</base_url>
            </gemini>
            <openai>
                <model>gpt-image-2.5-sunburst</model>
                <quality/>
            </openai>
        </mago_ai_image>
    </default>
</config>
